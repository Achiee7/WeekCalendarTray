<Window x:Class="WeekCalendarTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Week Calendar"
        Width="372"
        Height="560"
        AllowsTransparency="False"
        Background="Transparent"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource TrayButtonStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="7,2" />
        </Style>

        <Style x:Key="MonthToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMonthView}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DayToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDayView}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CalendarTitleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="4,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AgendaHoverBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <Border Width="12"
                                        Height="3"
                                        Margin="0,0,0,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        ClipToBounds="True"
                                        CornerRadius="2"
                                        IsHitTestVisible="False"
                                        Opacity="0.85"
                                        SnapsToDevicePixels="True"
                                        Visibility="{Binding EventIndicatorVisibility}">
                                    <ItemsControl ItemsSource="{Binding EventIndicatorBrushes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Background="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DayHoverBackgroundBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource OutsideMonthTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgendaEventButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="0">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AgendaHoverBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PeriodButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DayHoverBackgroundBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrentPeriod}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelectedPeriod}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverflowMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource WindowPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource WindowSurfaceBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding PrayerToggleColumnWidth}" />
                <ColumnDefinition Width="{Binding PrayerPanelColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="22"
                    Height="54"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding TogglePrayerPanelCommand}"
                    Content="{Binding PrayerToggleContent}"
                    Style="{StaticResource TrayButtonStyle}"
                    ToolTip="{Binding PrayerToggleToolTip}"
                    Visibility="{Binding PrayerFeatureVisibility}" />

            <Border Grid.Column="1"
                    Margin="0,16,8,16"
                    Padding="12"
                    Background="Transparent"
                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding PrayerPanelVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Prayer times" />
                    <TextBlock Grid.Row="1"
                               Margin="0,4,0,12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Text="{Binding PrayerLocationText}"
                               TextTrimming="CharacterEllipsis" />

                    <Border Grid.Row="2"
                            Margin="0,0,0,12"
                            Padding="10,9"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource AccentTextBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="Next prayer" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding PrayerCountdownText}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Row="3"
                                  ItemsSource="{Binding PrayerTimes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="PrayerRow"
                                        Margin="0,0,0,5"
                                        Padding="8,6"
                                        Background="Transparent"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="PrayerNameText"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}" />
                                            <TextBlock x:Name="PrayerNextText"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="10"
                                                       Text="next"
                                                       Visibility="{Binding NextVisibility}" />
                                        </StackPanel>
                                        <TextBlock x:Name="PrayerTimeText"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding TimeText}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                        <Setter TargetName="PrayerRow" Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="PrayerNameText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        <Setter TargetName="PrayerNextText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        <Setter TargetName="PrayerTimeText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="4"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Text="{Binding PrayerDateText}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

        <Grid Grid.Column="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="{Binding NavigationTitleRowHeight}" />
                <RowDefinition Height="{Binding WeekdayHeaderRowHeight}" />
                <RowDefinition Height="{Binding CalendarGridRowHeight}" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding ZoomOutCalendarCommand}"
                        Style="{StaticResource CalendarTitleButtonStyle}"
                        ToolTip="Show month overview">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding SelectedDateTitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Text="{Binding SelectedWeekTitle}" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Width="48"
                            Command="{Binding ShowMonthViewCommand}"
                            Content="Month"
                            Style="{StaticResource MonthToggleButtonStyle}"
                            ToolTip="Show the month grid" />
                    <Button Width="52"
                            Margin="2,0,0,0"
                            Command="{Binding DayOrTodayCommand}"
                            Content="{Binding DayButtonContent}"
                            Style="{StaticResource DayToggleButtonStyle}"
                            ToolTip="{Binding DayButtonToolTip}" />
                </StackPanel>
                <Button x:Name="MoreButton"
                        Grid.Column="3"
                        Width="30"
                        Height="30"
                        Click="MoreButton_Click"
                        Content="..."
                        Style="{StaticResource TrayButtonStyle}"
                        ToolTip="More actions" />
                <Popup x:Name="MoreMenuPopup"
                       Grid.Column="3"
                       AllowsTransparency="True"
                       HorizontalOffset="-118"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=MoreButton}"
                       StaysOpen="False"
                       VerticalOffset="6">
                    <Border Width="150"
                            Padding="4"
                            Background="{DynamicResource WindowPanelBrush}"
                            BorderBrush="{DynamicResource WindowBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              Color="{DynamicResource PopupShadowColor}"
                                              Direction="270"
                                              Opacity="{DynamicResource PopupShadowOpacity}"
                                              ShadowDepth="4" />
                        </Border.Effect>
                        <StackPanel>
                            <Button Click="SyncNowMenuItem_Click"
                                    Content="Sync now"
                                    Style="{StaticResource OverflowMenuButtonStyle}" />
                            <Button Click="OpenSettingsMenuItem_Click"
                                    Content="Settings"
                                    Style="{StaticResource OverflowMenuButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Button Grid.Column="5"
                        Width="30"
                        Height="30"
                        Command="{Binding HideCommand}"
                        Content="x"
                        Style="{StaticResource TrayButtonStyle}" />
            </Grid>

            <Grid Grid.Row="1"
                  VerticalAlignment="Center"
                  Visibility="{Binding NavigationTitleVisibility}">
                <Button Command="{Binding ZoomOutCalendarCommand}"
                        Style="{StaticResource CalendarTitleButtonStyle}"
                        ToolTip="Show wider calendar view">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="{Binding MonthTitle}" />
                </Button>
            </Grid>

            <Grid Grid.Row="2" Visibility="{Binding MonthViewVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource HeaderTextStyle}" Text="Wk" />
                <TextBlock Grid.Column="1" Style="{StaticResource HeaderTextStyle}" Text="Mo" />
                <TextBlock Grid.Column="2" Style="{StaticResource HeaderTextStyle}" Text="Tu" />
                <TextBlock Grid.Column="3" Style="{StaticResource HeaderTextStyle}" Text="We" />
                <TextBlock Grid.Column="4" Style="{StaticResource HeaderTextStyle}" Text="Th" />
                <TextBlock Grid.Column="5" Style="{StaticResource HeaderTextStyle}" Text="Fr" />
                <TextBlock Grid.Column="6" Style="{StaticResource HeaderTextStyle}" Text="Sa" />
                <TextBlock Grid.Column="7" Style="{StaticResource HeaderTextStyle}" Text="Su" />
                <Border Grid.Column="0"
                        Width="1"
                        Margin="0,2,0,2"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource WeekDividerBrush}" />
            </Grid>

            <ItemsControl Grid.Row="3"
                          ItemsSource="{Binding Weeks}"
                          Visibility="{Binding MonthViewVisibility}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding IsoWeekNumber, StringFormat={}{0:00}}" />
                            <Border Grid.Column="0"
                                    Width="1"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource WeekDividerBrush}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding DayNumber}"
                                                ToolTipOpening="DayPreview_Opening"
                                                MouseLeave="DayPreview_MouseLeave"
                                                ToolTipService.InitialShowDelay="650"
                                                ToolTipService.ShowDuration="3500"
                                                Style="{StaticResource DayButtonStyle}">
                                            <Button.ToolTip>
                                                <ToolTip MaxWidth="280" MaxHeight="240">
                                                    <TextBlock Text="{Binding EventPreviewText}" TextWrapping="Wrap"
                                                               MaxHeight="210" TextTrimming="CharacterEllipsis" />
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="2"
                          Grid.RowSpan="2"
                          Margin="2,10,2,0"
                          ItemsSource="{Binding OverviewItems}"
                          Visibility="{Binding OverviewVisibility}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="{Binding Label}"
                                Style="{StaticResource PeriodButtonStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="4"
                    Height="1"
                    Margin="0,6,0,0"
                    Background="{DynamicResource DividerBrush}" />

            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              Margin="0,0,0,0"
                              MaxHeight="{Binding AgendaMaxHeight}"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedDayEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8"
                                        Command="{Binding DataContext.OpenEventDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource AgendaEventButtonStyle}"
                                        ToolTip="Show event details">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding AccentBrush}"
                                                CornerRadius="2" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       Text="{Binding TimeText}" />
                                            <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       Text="{Binding Provider}" />
                                            <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="11"
                                                       Text="{Binding Location}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasLocation}" Value="True" />
                                                                    <Condition Binding="{Binding IsDayView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Text="{Binding AgendaEmptyText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding AgendaEmptyVisibility}" />
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Text="{Binding SyncStatusText}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Width="30"
                                Height="26"
                                Margin="0,0,10,0"
                                Command="{Binding AddEventCommand}"
                                Content="+"
                                Style="{StaticResource TrayButtonStyle}"
                                ToolTip="Add event" />
                        <Button Width="34"
                                Height="26"
                                Command="{Binding PreviousMonthCommand}"
                                Content="&lt;"
                                Style="{StaticResource TrayButtonStyle}"
                                ToolTip="{Binding PreviousStepToolTip}" />
                        <Button Width="34"
                                Height="26"
                                Margin="6,0,0,0"
                                Command="{Binding NextMonthCommand}"
                                Content="&gt;"
                                Style="{StaticResource TrayButtonStyle}"
                                ToolTip="{Binding NextStepToolTip}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
