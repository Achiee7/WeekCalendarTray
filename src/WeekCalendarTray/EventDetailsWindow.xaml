<Window x:Class="WeekCalendarTray.EventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Details"
        Width="460"
        Height="520"
        AllowsTransparency="False"
        Background="Transparent"
        KeyDown="Window_KeyDown"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="DetailTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DetailsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowSurfaceBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="DetailsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                               FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                               Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,16" Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12" Text="{Binding TimeText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Calendar" />
                    <TextBlock Style="{StaticResource DetailTextStyle}" Text="{Binding Provider}" />
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding LocationVisibility}">
                        <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Location" />
                        <TextBlock Style="{StaticResource DetailTextStyle}" Text="{Binding Location}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding OrganizerVisibility}">
                        <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Organizer" />
                        <TextBlock Style="{StaticResource DetailTextStyle}" Text="{Binding Organizer}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding SourceUrlVisibility}">
                        <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Link" />
                        <TextBox Text="{Binding SourceUrl, Mode=OneWay}" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 FontSize="12" Padding="0" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Hidden">
                            <TextBox.ToolTip>
                                <ToolTip MaxWidth="300">
                                    <TextBlock Text="{Binding SourceUrl}" TextWrapping="Wrap" />
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>
                    <TextBlock Margin="0,16,0,4" Style="{StaticResource DetailLabelStyle}" Text="Details" />
                    <TextBlock Style="{StaticResource DetailTextStyle}"
                               Text="{Binding Description}" />
                </StackPanel>
            </ScrollViewer>
            <WrapPanel x:Name="DetailsActions" Grid.Row="1" Margin="0,16,0,0"
                       HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="4,0,0,6" Click="Navigate_Click" Content="Navigate"
                        Style="{StaticResource DetailsButtonStyle}" Visibility="{Binding LocationVisibility}" />
                <Button Margin="4,0,0,6" Click="JoinTeams_Click" Content="Join Teams"
                        Style="{StaticResource DetailsButtonStyle}" Visibility="{Binding TeamsMeetingVisibility}" />
                <Button Margin="4,0,0,6" Click="OpenSource_Click" Content="Open link"
                        Style="{StaticResource DetailsButtonStyle}" Visibility="{Binding SourceUrlVisibility}" />
                <Button Margin="4,0,0,6" Click="Delete_Click" Content="Delete"
                        Style="{StaticResource DetailsButtonStyle}" Visibility="{Binding DeleteVisibility}" />
                <Button Margin="4,0,0,6" Click="Close_Click" Content="Close"
                        Style="{StaticResource DetailsButtonStyle}" IsCancel="True" />
            </WrapPanel>
        </Grid>
    </Border>
</Window>
